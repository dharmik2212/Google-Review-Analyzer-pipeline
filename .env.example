# Google Review Analyzer - Environment Variables
# Get your free Apify API token at https://console.apify.com/account/integrations
APIFY_TOKEN=your_apify_token_here

# Hugging Face token for sentiment analysis (cardiffnlp/twitter-roberta-base-sentiment-latest model)
# Create at https://huggingface.co/settings/tokens/new
HF_API_KEY=your_huggingface_token_here

